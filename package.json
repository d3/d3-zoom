{
  "name": "d3-zoom",
  "version": "3.0.1",
  "description": "Pan and zoom SVG, HTML or Canvas using mouse or touch input.",
  "homepage": "https://d3js.org/d3-zoom/",
  "repository": {
    "type": "git",
    "url": "https://github.com/d3/d3-zoom.git"
  },
  "keywords": [
    "d3",
    "d3-module",
    "zoom",
    "behavior",
    "interaction"
  ],
  "license": "ISC",
  "author": {
    "name": "Mike Bostock",
    "url": "https://bost.ocks.org/mike"
  },
  "type": "module",
  "files": [
    "dist/**/*.js",
    "dist/**/*.mjs"
  ],
  "module": "dist/d3-zoom.mjs",
  "main": "dist/d3-zoom.mjs",
  "jsdelivr": "dist/d3-zoom.min.js",
  "unpkg": "dist/d3-zoom.min.js",
  "exports": {
    "umd": "./dist/d3-zoom.min.js",
    "default": "./dist/d3-zoom.mjs"
  },
  "dependencies": {
    "d3-dispatch": "1 - 3",
    "d3-drag": "2 - 3",
    "d3-interpolate": "1 - 3",
    "d3-selection": "2 - 3",
    "d3-transition": "2 - 3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.2",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "jsdom": "^21.1.2",
    "rollup": "^4.67.4",
    "vitest": "^5.1.0"
  },
  "scripts": {
    "test": "vitest",
    "lint": "eslint",
    "prepublishOnly": "rm -rf dist && rollup -c"
  },
  "engines": {
    "node": ">=12"
  }
}
